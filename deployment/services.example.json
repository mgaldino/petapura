{
  "supervisor_python": "/caminho/python3",
  "collector_config": "/caminho/modelo-com-dados/config.json",
  "environment": {
    "PATH": "/caminho/node/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "PYTHONUNBUFFERED": "1",
    "WRANGLER_LOG_PATH": "/caminho/petapura/local/cloudflare/wrangler.log"
  },
  "services": {
    "collector": {
      "command": ["/caminho/python-com-asn1tools", "/caminho/modelo-com-dados/coletor.py", "watch"],
      "cwd": "/caminho/modelo-com-dados",
      "launch_receipt": "/caminho/modelo-com-dados/data/live/launch.json"
    },
    "publisher": {
      "command": [
        "/caminho/python3", "-u", "/caminho/petapura/scripts/run_cloudflare.py",
        "--wrangler", "/caminho/wrangler", "--rscript", "/caminho/Rscript",
        "--model-dir", "/caminho/modelo-com-dados",
        "--source", "/caminho/modelo-com-dados/data/live/tse_export",
        "--initial-state", "/caminho/modelo-com-dados/data/processed/estado_inicial_v2",
        "--runtime", "/caminho/petapura/local/cloudflare-production"
      ],
      "cwd": "/caminho/petapura",
      "launch_receipt": "/caminho/petapura/local/cloudflare/publisher-launch.json"
    }
  }
}
